{
  "name": "@worlds/sqlite",
  "description": "Synchronous SQLite-family durable backend for the Worlds client (developer-supplied node:sqlite / bun:sqlite handle) — RDF/JS quad primitive packaged with the worlds impl.",
  "version": "0.7.0",
  "license": "WTFPL",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./src/mod.ts",
    "./sql-core": "./src/sql-core/mod.ts",
    "./quad-store": "./src/sqlite/quad-store/mod.ts",
    "./search-index": "./src/sqlite/search-index/mod.ts",
    "./rdfjs-store": "./src/sqlite/rdfjs-store/mod.ts",
    "./schema": "./src/sqlite/schema/sqlite-schema-builder.ts"
  },
  "imports": {
    "@/": "./src/",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@types/node": "npm:@types/node@^26.2.0",
    "@types/n3": "npm:@types/n3@1.26.1",
    "n3": "npm:n3@^2.2.11",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@langchain/textsplitters": "npm:@langchain/textsplitters@^1.0.1",
    "sqlite-vec": "npm:sqlite-vec@^0.1.9",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@^0.4.1",
    "@wazoo/sparql-engine/term": "jsr:@wazoo/sparql-engine@^0.4.1/term",
    "@worlds/sdk": "jsr:@worlds/sdk@^0.6.1"
  },
  "minimumDependencyAge": 0,
  "publish": {
    "include": [
      "src/",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "tools/run-examples.ts",
      "test/"
    ]
  },
  "tasks": {
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check",
    "test": "deno test --allow-all",
    "publish:dry": "deno publish --dry-run --allow-dirty",
    "examples:check": "deno test --allow-all tools/run-examples.ts",
    "sql-core:purity": "deno run --allow-read tools/sql-core-purity.ts",
    "bench": "deno bench --allow-all benchmarks/",
    "bench:record": "deno run -A benchmarks/bench-record.ts",
    "bench:check": "deno run -A benchmarks/bench-check.ts",
    "ci": {
      "description": "Formats, lints, checks, tests, and example harness",
      "dependencies": [
        "fmt:check",
        "lint",
        "check",
        "test",
        "examples:check",
        "sql-core:purity"
      ]
    }
  },
  "test": {
    "exclude": [
      "src/sqlite/runtime-portability/bun-handle.portability.test.ts"
    ]
  }
}
